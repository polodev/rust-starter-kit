# Copy to .env and fill in. The real .env is git-ignored.
# Lines with a value are active. Lines that start with # are off: uncomment and fill them in when you need them.
# (An empty `NAME=` line would override the built-in default with nothing, which is why they are commented out.)
# The database kind is chosen when the app is built: mysql:// for the default build, postgres:// for
# `cargo run --features postgres` (see packages/loco-database/README.md).
DATABASE_URL=mysql://root@127.0.0.1:3306/rust_starter
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/rust_starter

# Cloudflare R2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_PUBLIC_BUCKET=
# R2_PRIVATE_BUCKET=
# R2_PUBLIC_URL=
R2_ROOT=rust-starter
# Uploaded files (module media): MEDIA_STORAGE=local keeps them in storage/uploads; r2 stores them in R2_PUBLIC_BUCKET.
MEDIA_STORAGE=local
MEDIA_DISK=default
# MEDIA_PREFIX=
# Public URL of the public bucket (an r2.dev address or your own domain); leave empty until it is enabled
TEST_DATABASE_URL=mysql://root@127.0.0.1:3306/rust_starter_test
# TEST_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/rust_starter_test

# Required in production. Must be base64 text: generate one with `openssl rand -base64 48`.
# Development and tests have a fake default.
# JWT_SECRET=

# Database backups (module db-backup). Separate from R2_*: use another bucket or even another account.
# Set DB_BACKUP_ENABLED=true to turn the scheduled and manual backups on.
DB_BACKUP_ENABLED=false
BACKUP_NAME=rust-starter
# BACKUP_BUCKET=
BACKUP_PREFIX=db-backups
# BACKUP_ENDPOINT=
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=

# Email (module mail). MAIL_DRIVER: log (writes .eml files, sends nothing) | ses | smtp
MAIL_DRIVER=log
# queue: mails wait in the database table mail_queue and a worker sends them. now: sent while the request waits.
MAIL_DELIVERY=queue
# true runs the worker inside the web server (development). In production set false and run `mail:work` under Supervisor.
MAIL_EMBEDDED_WORKER=true
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=
# Amazon SES (used when MAIL_DRIVER=ses): the IAM user's key, and the region of your verified sender
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_DEFAULT_REGION=
# Any SMTP server (MAIL_DRIVER=smtp), for example a local Mailpit on port 1025
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=none

# AI providers (module ai-service). Set a key to enable a provider. Model names change often: set them here.
# AI_DEFAULT_PROVIDER: claude | openai | gemini (empty: the first provider that has a key)
# AI_DEFAULT_PROVIDER=
# AI_DEFAULT_MODEL=
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60
# false keeps prompts and replies out of the AI API logs
AI_LOG_CONTENT=true
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=
# OPENAI_IMAGE_OUTPUT_FORMAT=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional prices (US dollars per million tokens) to estimate cost in the AI API logs:
# CLAUDE_INPUT_USD_PER_MILLION_TOKENS=  CLAUDE_OUTPUT_USD_PER_MILLION_TOKENS=  (same for OPENAI_ and GEMINI_)


# Redis for background jobs (Loco workers). Format: redis://[:password@]host:port/database-number
QUEUE_REDIS_URL=redis://127.0.0.1:6379/5

# Laravel-style database queue (jobs, failed_jobs tables)
JOBS_EMBEDDED_WORKER=true
JOBS_QUEUES=default
