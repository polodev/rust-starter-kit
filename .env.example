# Copy to .env and fill in. The real .env is git-ignored.
DATABASE_URL=mysql://root@127.0.0.1:3306/rust_starter

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
R2_ROOT=rust-starter
TEST_DATABASE_URL=mysql://root@127.0.0.1:3306/rust_starter_test

# Required in production (any long random string); development has a fake default.
JWT_SECRET=
